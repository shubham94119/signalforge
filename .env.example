APP_ENV=development
AUTH_MODE=local
INCIDENT_DB_PATH=./data/evidence.db
DEMO_SEED=1

# Optional provider-backed generation. For Ollama, use the local values below.
MODEL_ENDPOINT=http://host.docker.internal:11434/v1/chat/completions
MODEL_API_KEY=ollama
MODEL_NAME=llama3.2:3b
MODEL_TIMEOUT_SECONDS=180
MODEL_TEMPERATURE=0
MODEL_MAX_TOKENS=900

# Browser origin allowed by the API.
UI_ORIGIN=http://127.0.0.1:5173
